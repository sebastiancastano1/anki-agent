{
  "annotations": { "list": [] },
  "editable": true,
  "title": "anki-agent · Tiempo real (operativo)",
  "uid": "anki-agent-realtime",
  "schemaVersion": 39,
  "tags": ["anki-agent", "llm", "tiempo-real"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    { "type": "row", "title": "🟢 Estado ahora", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "stat", "title": "Runs (última hora)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Runs del pipeline iniciados en la última hora.",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(traces_span_metrics_calls_total{span_name=\"research_pipeline.workflow\"}[1h]))", "legendFormat": "runs" } ]
    },
    {
      "type": "stat", "title": "Throughput LLM (req/min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Llamadas anthropic.chat por minuto (tasa actual).",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqpm", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(traces_span_metrics_calls_total{span_name=\"anthropic.chat\"}[$__rate_interval])) * 60", "legendFormat": "req/min" } ]
    },
    {
      "type": "stat", "title": "p95 (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latencia p95 del pipeline en los últimos 5 minutos.",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30000 }, { "color": "red", "value": 60000 } ] } } },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"research_pipeline.workflow\"}[5m])))", "legendFormat": "p95" } ]
    },
    {
      "type": "stat", "title": "Error rate (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "% de spans con error en los últimos 5 minutos.",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } } },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * (sum(rate(traces_span_metrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m])) or vector(0)) / clamp_min(sum(rate(traces_span_metrics_calls_total[5m])), 1)", "legendFormat": "error %" } ]
    },
    {
      "type": "stat", "title": "Cache-hit (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "% de turnos servidos desde caché en los últimos 5 minutos.",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 } ] } } },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * (sum(rate(traces_span_metrics_calls_total{app_gen_ai_cache_hit=\"true\"}[5m])) or vector(0)) / clamp_min(sum(rate(traces_span_metrics_calls_total{app_gen_ai_cache_hit=~\"true|false\"}[5m])), 1)", "legendFormat": "cache-hit" } ]
    },
    {
      "type": "stat", "title": "Costo (última hora)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Gasto en USD en la última hora.",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(gen_ai_cost_usd_total[1h]))", "legendFormat": "USD" } ]
    },

    { "type": "row", "title": "⚡ En vivo", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 } },
    {
      "type": "timeseries", "title": "Throughput por span (req/min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Actividad en vivo por span.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "spanNulls": true } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (span_name) (rate(traces_span_metrics_calls_total[$__rate_interval])) * 60", "legendFormat": "{{span_name}}" } ]
    },
    {
      "type": "timeseries", "title": "Latencia en vivo (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentiles de latencia del pipeline en tiempo real.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"research_pipeline.workflow\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"research_pipeline.workflow\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"research_pipeline.workflow\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries", "title": "Errores por span (req/min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tasa de errores en vivo. Cualquier barra = atención.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1 }, "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (span_name) (rate(traces_span_metrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) * 60", "legendFormat": "{{span_name}}" } ]
    },
    {
      "type": "timeseries", "title": "Costo por minuto (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tasa de gasto en vivo.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 }, "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(gen_ai_cost_usd_total[$__rate_interval])) * 60", "legendFormat": "USD/min" } ]
    },

    { "type": "row", "title": "🔍 Últimas trazas", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 } },
    {
      "type": "table", "title": "Runs recientes — research_pipeline (clic para abrir la traza)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Últimas trazas del pipeline. Del KPI a la ejecución concreta.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 24 },
      "targets": [ { "datasource": { "type": "tempo", "uid": "tempo" }, "queryType": "traceql", "query": "{ name = \"research_pipeline.workflow\" }", "tableType": "traces", "limit": 10, "refId": "A" } ]
    }
  ]
}
