{
  "annotations": { "list": [] },
  "editable": true,
  "title": "anki-agent · LLM cost & traces",
  "uid": "anki-agent-llm",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Costo total (USD, rango)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ span.app.cost.total > 0 } | sum(span.app.cost.total)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cache-hit rate (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(calls_total{app_gen_ai_cache_hit=\"true\"}[$__range])) / clamp_min(sum(increase(calls_total{app_gen_ai_cache_hit=~\"true|false\"}[$__range])), 1)",
          "legendFormat": "cache-hit"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Runs (rango)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(calls_total{span_name=\"research_pipeline\"}[$__range]))",
          "legendFormat": "runs"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latencia por span (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (span_name, le) (rate(duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Costo por minuto (USD)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ span.app.cost.total > 0 } | sum(span.app.cost.total)"
        }
      ]
    }
  ]
}
