{
  "annotations": { "list": [] },
  "editable": true,
  "title": "anki-agent · LLM observability",
  "uid": "anki-agent-llm",
  "schemaVersion": 39,
  "tags": ["anki-agent", "llm", "otel"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Modelo",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(traces_span_metrics_calls_total, gen_ai_response_model)", "refId": "model" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "📊 Resumen",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Costo total (rango)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Suma del costo (USD) de todas las llamadas LLM en el rango seleccionado.",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(gen_ai_cost_usd_total[$__range]))",
          "legendFormat": "costo"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Costo / run",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Costo promedio por run del pipeline de research en el rango.",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(gen_ai_cost_usd_total[$__range])) / clamp_min(sum(increase(traces_span_metrics_calls_total{span_name=\"research_pipeline.workflow\"}[$__range])), 1)",
          "legendFormat": "USD/run"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Runs (rango)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Número de runs del pipeline de research (span research_pipeline.workflow).",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(traces_span_metrics_calls_total{span_name=\"research_pipeline.workflow\"}[$__range]))",
          "legendFormat": "runs"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cache-hit rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "% de turnos del agente servidos desde caché de prompt. Más alto = más barato y rápido.",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(increase(traces_span_metrics_calls_total{app_gen_ai_cache_hit=\"true\"}[$__range])) or vector(0)) / clamp_min(sum(increase(traces_span_metrics_calls_total{app_gen_ai_cache_hit=~\"true|false\"}[$__range])), 1)",
          "legendFormat": "cache-hit"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 pipeline",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latencia p95 de un run completo (research_pipeline.workflow).",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30000 },
              { "color": "red", "value": 60000 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"research_pipeline.workflow\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "% de spans con estado de error sobre el total, en el rango.",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(increase(traces_span_metrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[$__range])) or vector(0)) / clamp_min(sum(increase(traces_span_metrics_calls_total[$__range])), 1)",
          "legendFormat": "error-rate"
        }
      ]
    },

    {
      "type": "row",
      "title": "💸 Costo",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Costo por minuto (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tasa de gasto en USD/min. Picos = runs caros o sin caché.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(gen_ai_cost_usd_total[$__rate_interval])) * 60",
          "legendFormat": "USD/min"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Costo acumulado (rango)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Costo acumulado dentro del rango seleccionado.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": { "drawStyle": "line", "fillOpacity": 25, "lineWidth": 2 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gen_ai_cost_usd_total) - scalar(min_over_time(sum(gen_ai_cost_usd_total)[$__range:]))",
          "legendFormat": "acumulado (rango)"
        }
      ]
    },

    {
      "type": "row",
      "title": "⏱️ Latencia",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "Percentiles pipeline (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Distribución de latencia de un run completo. La brecha p50↔p99 mide la cola.",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"research_pipeline.workflow\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"research_pipeline.workflow\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"research_pipeline.workflow\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latencia por span",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latencia p95 desglosada por span (pipeline, turnos, anthropic.chat). Identifica el cuello de botella.",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (span_name, le) (rate(traces_span_metrics_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Distribución de latencia (heatmap)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Densidad de duración de spans por bucket. Bandas calientes = donde cae la mayoría de requests.",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 16 },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "scheme": "Spectral", "mode": "scheme", "steps": 64 },
        "yAxis": { "unit": "ms" },
        "legend": { "show": true },
        "tooltip": { "show": true, "yHistogram": true }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ]
    },

    {
      "type": "row",
      "title": "🚦 Tráfico y errores",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },
    {
      "type": "timeseries",
      "title": "Throughput por span (req/min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tasa de llamadas por span por minuto.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (span_name) (rate(traces_span_metrics_calls_total[$__rate_interval])) * 60",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errores por span (req/min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tasa de spans con estado de error. Idealmente plano en 0.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1 },
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (span_name) (rate(traces_span_metrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) * 60",
          "legendFormat": "{{span_name}}"
        }
      ]
    },

    {
      "type": "row",
      "title": "🎯 Calidad / Cache",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "type": "timeseries",
      "title": "Cache-hit rate en el tiempo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Evolución del % de turnos servidos desde caché.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 } ] }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(rate(traces_span_metrics_calls_total{app_gen_ai_cache_hit=\"true\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(traces_span_metrics_calls_total{app_gen_ai_cache_hit=~\"true|false\"}[$__rate_interval])), 1)",
          "legendFormat": "cache-hit %"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turnos: cache-hit vs miss (req/min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Volumen de turnos del agente con y sin caché.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "drawStyle": "line", "fillOpacity": 25, "lineWidth": 2, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traces_span_metrics_calls_total{app_gen_ai_cache_hit=\"true\"}[$__rate_interval])) * 60",
          "legendFormat": "cache-hit"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traces_span_metrics_calls_total{app_gen_ai_cache_hit=\"false\"}[$__rate_interval])) * 60",
          "legendFormat": "cache-miss"
        }
      ]
    },

    {
      "type": "row",
      "title": "🔍 Trazas (Tempo)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 }
    },
    {
      "type": "table",
      "title": "Runs recientes — research_pipeline (clic para abrir la traza)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Trazas recientes del pipeline. Cierra el loop métrica→traza: del KPI a la ejecución concreta.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 44 },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ name = \"research_pipeline.workflow\" }",
          "tableType": "traces",
          "limit": 20,
          "refId": "A"
        }
      ]
    },

    {
      "type": "row",
      "title": "🪙 Tokens y costo por componente",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 }
    },
    {
      "type": "timeseries",
      "title": "Tokens por tipo (rango)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tokens consumidos por tipo. input = no-cacheados; cache_read suele dominar cuando la caché funciona.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 55 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(gen_ai_tokens_input_total{gen_ai_response_model=~\"$model\"}[$__rate_interval]))", "legendFormat": "input" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(gen_ai_tokens_output_total{gen_ai_response_model=~\"$model\"}[$__rate_interval]))", "legendFormat": "output" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(gen_ai_tokens_cache_read_total{gen_ai_response_model=~\"$model\"}[$__rate_interval]))", "legendFormat": "cache_read" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(gen_ai_tokens_cache_write_total{gen_ai_response_model=~\"$model\"}[$__rate_interval]))", "legendFormat": "cache_write" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Costo por componente (rango)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Desglose del costo USD por componente. Dónde se va realmente el dinero.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 55 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(gen_ai_cost_input_usd_total{gen_ai_response_model=~\"$model\"}[$__rate_interval]))", "legendFormat": "input" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(gen_ai_cost_output_usd_total{gen_ai_response_model=~\"$model\"}[$__rate_interval]))", "legendFormat": "output" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(gen_ai_cost_cache_read_usd_total{gen_ai_response_model=~\"$model\"}[$__rate_interval]))", "legendFormat": "cache_read" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(gen_ai_cost_cache_write_usd_total{gen_ai_response_model=~\"$model\"}[$__rate_interval]))", "legendFormat": "cache_write" }
      ]
    },
    {
      "type": "piechart",
      "title": "Costo por modelo (rango)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Reparto del costo total entre modelos.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 55 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (gen_ai_response_model) (increase(gen_ai_cost_usd_total[$__range]))", "legendFormat": "{{gen_ai_response_model}}" }
      ]
    }
  ]
}
