{
  "name": "anki-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:setup": "prisma generate && prisma db push",
    "setup": "npm install && npm run db:setup",
    "obs:up": "docker compose -f otel/docker-compose.yml up -d",
    "obs:down": "docker compose -f otel/docker-compose.yml down",
    "obs:logs": "docker compose -f otel/docker-compose.yml logs -f",
    "obs:langfuse:up": "docker compose --env-file .env -f otel/docker-compose.yml -f otel/docker-compose.langfuse.yml up -d",
    "obs:langfuse:down": "docker compose --env-file .env -f otel/docker-compose.yml -f otel/docker-compose.langfuse.yml down",
    "start:all": "bash scripts/dev-up.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.16.2",
    "@tailwindcss/typography": "^0.5.19",
    "@traceloop/node-server-sdk": "^0.27.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^1.17.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
